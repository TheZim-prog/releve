{
  // Fréquence de la simulation (à confirmer en jeu).
  "ticksPerSecond": 20,

  // Une jauge est pleine quand elle atteint cette valeur. Chaque tick, elle gagne
  // l'initiative de l'unité : avec 1000 et une initiative de 10, il faut 100 ticks (5 s).
  "gaugeCapacity": 1000,

  // Pourcentage de la capacité dont repart la jauge selon le poids de l'activation.
  "moveOnlyRestartPercent": 50,
  "lightActionRestartPercent": 40,
  "heavyActionRestartPercent": 0,

  // Une unité déséquilibrée remplit sa jauge à ce pourcentage de sa vitesse normale.
  "offBalanceFillPercent": 50,

  // Renforcements : jauge d'une unité accélérée (Hypervitesse) et dégâts d'une unité surpuissante
  // (Forme d'énergie pure), en % de la normale. Se combinent avec le déséquilibre en se multipliant.
  "hastedFillPercent": 300,
  "empoweredDamagePercent": 150,

  // Point faible (passif du combattant) : la cible frappée devient vulnérable et prend ce % de dégâts
  // (de toutes les sources) pendant cette durée.
  "exposedDamageTakenPercent": 125,
  "weakPointExposedMs": 4000,

  // Emprise (passif du télépathe) : ses états néfastes durent ce % de leur durée normale.
  "gripDurationPercent": 150,

  // Une unité IA fixe son intention (action + cible) quand sa jauge atteint ce pourcentage.
  "intentionThresholdPercent": 50,

  // Relever un allié à terre (action « interagir ») : il revient avec ce % de ses PV max ;
  // le releveur repart selon ce poids.
  "reviveHpPercent": 25,
  "reviveWeight": "light",

  // Couverture : un coup venu de loin dont la ligne passe par un obstacle bas collé à la cible perd ce %
  // de ses dégâts ; l'obstacle encaisse la part absorbée et devient du sol à 0 PV.
  "coverDamageReductionPercent": 50,
  "lowObstacleHp": 40
}
