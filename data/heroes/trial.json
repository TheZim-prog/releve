// Héros d'essai : niveau 20, des kits différents de ceux du prologue, pour jouer les compétences ajoutées au fur et à
// mesure (scénario « trial »). Pour essayer une variante, la mettre dans "equipped" à la place de sa compétence.
[
  {
    // Lutteur et Cogneur en mouvement : Écrasement (variante de leap), Renversement (variante de projection) et
    // Catapulte (variante : cannonball, l'allié lancé blesse autour de lui).
    // À essayer aussi : hammer-blow (variante : quake), steel-skin (aegis), provocation (challenge), arm-lock (dismantle).
    "id": "trial-colossus", "archetype": "colossus", "level": 20,
    "points": { "hp": 12, "power": 5, "initiative": 2 },
    "learned": ["dome", "provocation", "steel-skin", "leap", "hammer-blow", "throw-scenery", "rage", "shockwave", "projection",
                "arm-lock", "catapult", "vigilance", "bodyguard"],
    // Passif : Garde du corps (autres : vigilance, rage).
    "equipped": ["crush", "reversal", "catapult", "shockwave"],
    "passive": "bodyguard"
  },
  {
    // Éclair et Sauveteur : Aller-retour (variante : running-strike), Dégagement (variante : trip) et Transport
    // (variante : swap). À essayer aussi : slalom (variante de breakthrough), harassment (variante : pickpocket).
    "id": "trial-speedster", "archetype": "speedster", "level": 20,
    "points": { "hp": 4, "power": 3, "initiative": 12 },
    "learned": ["whirlwind", "harassment", "flash-rescue", "clearance", "carry", "slipstream", "collective-surge",
                "breakthrough", "round-trip", "ignoresOpportunityAttacks", "chain-strike", "reflexes"],
    // Mur de vent (variante de whirlwind ; remettre whirlwind pour dissiper le Fumigène du combattant).
    // Frappe en chaîne (variante : ricochet).
    "equipped": ["chain-strike", "wind-wall", "clearance", "collective-surge"],
    // Passif : Réflexes (autres : ignoresOpportunityAttacks, slipstream).
    "passive": "reflexes"
  },
  {
    // La Ruée (variante : retreat), les variantes Balayage (Coup étourdissant) et Volée (Lames de jet).
    // À essayer aussi : disarm.
    // À essayer aussi : precise-strike, qui ignore les protections, et sa variante pincer.
    "id": "trial-fighter", "archetype": "fighter", "level": 20,
    "points": { "hp": 6, "power": 8, "initiative": 5 },
    "learned": ["stunning-blow", "parry", "disarm", "throwing-blades", "smoke-bomb", "precise-strike", "rush", "relentless", "weakPoint",
                "execution", "trap", "riposte", "weapon-master"],
    // Fumigène (variante : tear-gas) et Piège (variante : explosive-trap).
    // Parade (variante : deflection), Maître d'armes, passif Riposte.
    "equipped": ["parry", "smoke-bomb", "trap", "weapon-master"],
    "passive": "riposte"
  },
  {
    // Brasier et Glace : Onde de recul (variante de nova), Propulsion (variante : comet), Éclat de glace, Zéro absolu.
    // À essayer aussi : fire-lance, melting-point.
    // Variantes à essayer : electric-arc (beam), controlled-blast (blast), discharge (melting-point), freeze (ice-shard).
    "id": "trial-energetic", "archetype": "energetic", "level": 20,
    "points": { "hp": 3, "power": 13, "initiative": 3 },
    "learned": ["beam", "blast", "fire-lance", "piercing", "ice-shard", "ice-wall", "black-ice", "frost", "absolute-zero",
                "nova", "propulsion", "melting-point"],
    // Mur de glace (variante : ice-pillar) et Verglas (variante : frostbite).
    // Chaîne d'éclairs (variante de fire-lance).
    "equipped": ["ice-wall", "black-ice", "chain-lightning", "absolute-zero"],
    "passive": "piercing"
  },
  {
    // Tacticien et Saboteur : Tir de désignation (variante : suppression-shot) et Électrochoc (variante : net).
    // À essayer aussi : shield-beacon, variante de nano-heal. Passif : Champ de brouillage (autres : energyRecovery).
    "id": "trial-tech", "archetype": "tech", "level": 20,
    "points": { "hp": 5, "power": 7, "initiative": 7 },
    "learned": ["turret", "nano-heal", "designation-shot", "covering-fire", "tactical-order", "tacticalAnalysis",
                "electroshock", "jamming", "hacking", "jammingField", "emp", "energyRecovery", "trap"],
    // Le Piège explosif (variante de trap, partagé avec le combattant).
    // Tir de couverture (variante : close-protection).
    "equipped": ["covering-fire", "explosive-trap", "designation-shot", "emp"],
    "passive": "jammingField"
  },
  {
    // Poussée (variante de telekinesis), les variantes de zone Torpeur (Paralysie) et Panique (Confusion), et l'Étau
    // (variante : wrench). À essayer aussi : projectile.
    // À essayer aussi : stimulation (variante : focus), déjà achetée.
    "id": "trial-telepath", "archetype": "telepath", "level": 20,
    "points": { "hp": 5, "power": 7, "initiative": 7 },
    "learned": ["paralysis", "telepathic-strike", "confusion", "grip", "domination", "telekinesis", "projectile", "vise", "siphon",
                "stimulation"],
    "equipped": ["torpor", "panic", "shove", "vise"],
    "passive": "grip"
  }
]
