// Héros d'essai : niveau 20, des kits différents de ceux du prologue, pour jouer les compétences ajoutées au fur et à
// mesure (scénario « trial »). Pour essayer une variante, la mettre dans "equipped" à la place de sa compétence.
[
  {
    // Rempart et Lutteur au complet : Bouclier personnel (variante de dome), Forteresse, Tourniquet, et le Lancer de
    // décor (variante : barricade ; il faut un obstacle bas à son contact).
    // À essayer aussi : leap (variante : crush), projection (reversal), catapult (cannonball), hammer-blow (quake),
    // steel-skin (aegis), provocation (challenge), arm-lock (dismantle).
    "id": "trial-colossus", "archetype": "colossus", "level": 20,
    "points": { "hp": 12, "power": 5, "initiative": 2 },
    "learned": ["dome", "provocation", "steel-skin", "bodyguard", "fortress", "projection", "arm-lock", "catapult", "vigilance",
                "spin-throw", "leap", "hammer-blow", "throw-scenery"],
    // Passif : Garde du corps (autre : vigilance ; unshakable demande un point de plus dans Rempart).
    "equipped": ["personal-shield", "fortress", "spin-throw", "throw-scenery"],
    "passive": "bodyguard"
  },
  {
    // Éclair (sans Hypervitesse) et Perturbateur (sans Voleur de temps), plus le début du Sauveteur : Dégagement
    // (variante : trip) et Transport (variante : swap). À essayer aussi : round-trip (variante : running-strike), slalom
    // (variante de breakthrough), harassment (variante : pickpocket), flash-rescue (variante : express-revive).
    "id": "trial-speedster", "archetype": "speedster", "level": 20,
    "points": { "hp": 4, "power": 3, "initiative": 12 },
    "learned": ["whirlwind", "harassment", "flash-rescue", "clearance", "carry", "afterimage", "diversion", "vortex",
                "breakthrough", "round-trip", "ignoresOpportunityAttacks", "chain-strike", "reflexes"],
    // Mur de vent (variante de whirlwind ; remettre whirlwind pour dissiper le Fumigène du combattant).
    // Frappe en chaîne (variante : ricochet).
    // Image rémanente (variante : rigged-decoy).
    // Vortex : les ennemis d'une grande zone sont attirés vers son centre.
    "equipped": ["chain-strike", "afterimage", "clearance", "vortex"],
    // Passif : Réflexes (autres : ignoresOpportunityAttacks, diversion).
    "passive": "reflexes"
  },
  {
    // Acharnement (variante : finishing-blow), Lancer mortel (chargé, à longue portée), Parade (variante : deflection),
    // Maître d'armes, passif Riposte.
    // À essayer aussi : smoke-bomb (variante : tear-gas), trap (explosive-trap), rush (retreat), disarm (offbeat),
    // stunning-blow (sweep), precise-strike (pincer), throwing-blades (volley).
    "id": "trial-fighter", "archetype": "fighter", "level": 20,
    "points": { "hp": 6, "power": 8, "initiative": 5 },
    "learned": ["stunning-blow", "parry", "disarm", "riposte", "weapon-master", "throwing-blades", "smoke-bomb", "trap", "firstBlood",
                "deadly-throw", "precise-strike", "rush", "relentless"],
    "equipped": ["relentless", "deadly-throw", "parry", "weapon-master"],
    "passive": "riposte"
  },
  {
    // Brasier et Glace : Onde de recul (variante de nova), Propulsion (variante : comet), Éclat de glace, Zéro absolu.
    // À essayer aussi : fire-lance, melting-point.
    // Variantes à essayer : electric-arc (beam), controlled-blast (blast), discharge (melting-point), freeze (ice-shard).
    "id": "trial-energetic", "archetype": "energetic", "level": 20,
    "points": { "hp": 3, "power": 13, "initiative": 3 },
    "learned": ["beam", "blast", "fire-lance", "piercing", "ice-shard", "ice-wall", "black-ice", "frost", "absolute-zero", "star",
                "nova", "propulsion", "melting-point"],
    // Mur de glace (variante : ice-pillar) et Verglas (variante : frostbite).
    // Chaîne d'éclairs (variante de fire-lance).
    // Astre (le gros coup de la branche Feu ; absolute-zero, celui de la Glace, est aussi acheté).
    "equipped": ["ice-wall", "black-ice", "chain-lightning", "star"],
    // Passif : Perforant (autres : frost ; excess, Démesure, à acheter à la place d'une autre case).
    "passive": "piercing"
  },
  {
    // Ingénieur complet : Drone de combat, Tourelle de suppression (variante de turret), Piège explosif (variante de
    // trap), passif Surcadençage (autre : doubleDeployment). Et le Tir de couverture (variante : close-protection).
    // À essayer aussi : shield-beacon (variante de nano-heal), designation-shot, electroshock.
    "id": "trial-tech", "archetype": "tech", "level": 20,
    "points": { "hp": 5, "power": 7, "initiative": 7 },
    "learned": ["turret", "nano-heal", "trap", "overclocking", "combat-drone", "doubleDeployment",
                "designation-shot", "covering-fire", "tactical-order", "electroshock", "jamming", "hacking", "tacticalAnalysis"],
    // À essayer aussi : hacking (variante : virus) contre un robot, tactical-order (variante : reload), et le passif
    // tacticalAnalysis (les intentions des ennemis proches s'affichent).
    "equipped": ["combat-drone", "suppression-turret", "covering-fire", "explosive-trap"],
    "passive": "overclocking"
  },
  {
    // Frappe télépathique (variante : psychic-scream, sans ligne de vue elle aussi), Siphon (variante : transfusion),
    // Clarté (variante : serenity) et Onde de force. Domination secoue un boss.
    // À essayer aussi : paralysis (variante : torpor), confusion (panic), domination, telekinesis (shove), projectile
    // (telekinetic-throw), vise (wrench), stimulation (focus).
    "id": "trial-telepath", "archetype": "telepath", "level": 20,
    "points": { "hp": 5, "power": 7, "initiative": 7 },
    "learned": ["paralysis", "telepathic-strike", "confusion", "grip", "domination", "telekinesis", "projectile", "vise", "siphon",
                "stimulation", "clarity", "kineticScreen", "force-wave"],
    "equipped": ["telepathic-strike", "siphon", "clarity", "force-wave"],
    // Passif : Emprise (autre : kineticScreen).
    "passive": "grip"
  }
]
