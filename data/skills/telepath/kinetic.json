// Télépathe, branche Kinésiste : déplacer la matière (marche aussi sur les robots).
[
  {
    // Déplace un allié ou un ennemi sur une case libre choisie.
    "id": "telekinesis", "name": "Télékinésie",
    "target": "any", "weight": "light", "range": 5, "minDamage": 0, "maxDamage": 0, "cooldownMs": 12000,
    "forcedMove": { "type": "place", "distance": 3 }
  },
  {
    // Lance un débris sur une cible à distance.
    "id": "projectile", "name": "Projectile",
    "weight": "light", "range": 5, "minDamage": 9, "maxDamage": 12, "cooldownMs": 5000
  },
  {
    // Variante du Projectile : soulève un obstacle bas à portée et en vue (le plus près de la case visée) et le lance :
    // dégâts de zone, obstacle détruit.
    "id": "telekinetic-throw", "name": "Lancer de décor",
    "weight": "light", "range": 5, "minDamage": 9, "maxDamage": 12, "cooldownMs": 8000,
    "zone": { "shape": "square", "size": 1, "throughWalls": false },
    "scenery": { "use": "throw", "reach": 5 }
  },
  {
    // Dégâts légers, et immobilise une cible à distance.
    "id": "vise", "name": "Étau",
    "weight": "light", "range": 5, "minDamage": 5, "maxDamage": 7, "cooldownMs": 10000,
    "effects": [ { "status": "immobilized", "durationMs": 3000 } ]
  },
  {
    // Variante de l'Étau : désarme la cible au lieu de l'immobiliser.
    "id": "wrench", "name": "Arrachement",
    "weight": "light", "range": 5, "minDamage": 5, "maxDamage": 7, "cooldownMs": 10000,
    "effects": [ { "status": "disarmed", "durationMs": 3000 } ]
  },
  {
    // Variante de la Télékinésie : projette un ennemi en ligne droite loin de lui ; dégâts s'il percute quelque chose.
    "id": "shove", "name": "Poussée",
    "weight": "light", "range": 5, "minDamage": 0, "maxDamage": 0, "cooldownMs": 12000,
    "forcedMove": { "type": "push", "distance": 3, "collisionMinDamage": 9, "collisionMaxDamage": 13 }
  }
]
