// Énergétique, branche Brasier : le corps à corps.
[
  {
    // Explosion autour de lui, pour se dégager.
    "id": "nova", "name": "Nova",
    "weight": "light", "range": 0, "minDamage": 9, "maxDamage": 12, "cooldownMs": 8000,
    "zone": { "shape": "square", "size": 1, "throughWalls": false }
  },
  {
    // Plus de dégâts pendant 2 ou 3 actions. 11,5 s : lancée (lourde), elle couvre 3 actions légères d'un héros établi
    // (à 5 s, 8 s et 11 s), ou 2 si l'une est lourde.
    "id": "energy-form", "name": "Forme d'énergie pure",
    "target": "self", "weight": "heavy", "range": 0, "minDamage": 0, "maxDamage": 0, "cooldownMs": 25000,
    "effects": [ { "status": "empowered", "durationMs": 11500 } ]
  },
  {
    // Énormes dégâts sur une cible au contact.
    "id": "melting-point", "name": "Point de fusion",
    "weight": "light", "range": 1, "minDamage": 22, "maxDamage": 28, "cooldownMs": 12000
  },
  {
    // Variante électrique du Point de fusion : moins de dégâts, étourdit brièvement la cible.
    "id": "discharge", "name": "Décharge",
    "weight": "light", "range": 1, "minDamage": 13, "maxDamage": 17, "cooldownMs": 12000,
    "effects": [ { "status": "stunned", "durationMs": 1500 } ]
  },
  {
    // Variante de la Nova : moins de dégâts, mais tout ce qu'elle touche est repoussé d'une case.
    "id": "recoil-wave", "name": "Onde de recul",
    "weight": "light", "range": 0, "minDamage": 5, "maxDamage": 7, "cooldownMs": 8000,
    "zone": { "shape": "square", "size": 1, "throughWalls": false },
    "forcedMove": { "type": "push", "distance": 1, "collisionMinDamage": 4, "collisionMaxDamage": 6 }
  },
  {
    // Se propulse sur une case libre ; l'explosion frappe autour de sa case de départ.
    "id": "propulsion", "name": "Propulsion",
    "weight": "light", "range": 4, "minDamage": 9, "maxDamage": 12, "cooldownMs": 10000,
    "selfMove": "leap", "selfMoveOptions": { "zoneAtStart": true },
    "zone": { "shape": "square", "size": 1, "throughWalls": false }
  },
  {
    // Variante de la Propulsion : l'explosion a lieu à l'arrivée.
    "id": "comet", "name": "Comète",
    "weight": "light", "range": 4, "minDamage": 9, "maxDamage": 12, "cooldownMs": 10000,
    "selfMove": "leap",
    "zone": { "shape": "square", "size": 1, "throughWalls": false }
  }
]
