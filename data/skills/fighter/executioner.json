// Combattant, branche Exécuteur : éliminer une cible précise.
[
  {
    // Coup puissant qui ignore les protections : ni dôme ni PV temporaires ne l'arrêtent.
    "id": "precise-strike", "name": "Frappe précise",
    "weight": "light", "range": 1, "minDamage": 18, "maxDamage": 23, "cooldownMs": 8000,
    "ignoresProtections": true
  },
  {
    // Achève une cible sous 30 % de PV (pas un boss), sinon très gros dégâts.
    "id": "execution", "name": "Exécution",
