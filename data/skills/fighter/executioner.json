    "weight": "light", "range": 1, "minDamage": 18, "maxDamage": 23, "cooldownMs": 8000,
    "flankDamagePercent": 150
  },
  {
    // Court jusqu'à un ennemi (4 pas, sans attaque d'opportunité) et le frappe.
