// Combattant, branche Exécuteur : éliminer une cible précise.
[
  {
    // Coup puissant qui ignore les protections : ni dôme ni PV temporaires ne l'arrêtent.
    "id": "precise-strike", "name": "Frappe précise",
    "weight": "light", "range": 1, "minDamage": 18, "maxDamage": 23, "cooldownMs": 8000,
    "ignoresProtections": true
  },
  {
    // Achève une cible sous 30 % de PV (pas un boss), sinon très gros dégâts.
    "id": "execution", "name": "Exécution",
    "weight": "heavy", "range": 1, "minDamage": 24, "maxDamage": 31, "cooldownMs": 20000,
    "executeAtOrBelowPercent": 30
  },
  {
    // Variante de la Frappe précise : n'ignore plus les protections, mais frappe plus fort si un allié est aussi au
    // contact de la cible.
    "id": "pincer", "name": "Prise en tenaille",
    "weight": "light", "range": 1, "minDamage": 18, "maxDamage": 23, "cooldownMs": 8000,
    "flankDamagePercent": 150
  },
  {
    // Gros coup au contact ; si la cible tombe, la recharge est annulée.
    "id": "relentless", "name": "Acharnement",
    "weight": "light", "range": 1, "minDamage": 15, "maxDamage": 19, "cooldownMs": 10000,
    "resetsCooldownOnKill": true
  },
  {
    // Variante de l'Acharnement : plus de recharge annulée, mais des dégâts qui montent avec les PV manquants de la
    // cible (jusqu'au double contre une cible presque à terre), boss compris.
    "id": "finishing-blow", "name": "Coup de grâce",
    "weight": "light", "range": 1, "minDamage": 12, "maxDamage": 15, "cooldownMs": 10000,
    "missingHpDamageBonusPercent": 100
  },
  {
    // Court jusqu'à un ennemi (4 pas, sans attaque d'opportunité) et le frappe.
    "id": "rush", "name": "Ruée",
    "weight": "light", "range": 4, "minDamage": 10, "maxDamage": 13, "cooldownMs": 8000,
    "selfMove": "dash"
  },
  {
    // Variante de la Ruée : frappe un ennemi au contact, puis s'éloigne (3 pas, sans attaque d'opportunité).
    "id": "retreat", "name": "Retraite",
    "weight": "light", "range": 1, "minDamage": 9, "maxDamage": 12, "cooldownMs": 8000,
    "selfMove": "retreat", "selfMoveOptions": { "retreatDistance": 3 }
  }
]
