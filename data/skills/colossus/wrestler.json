// Colosse, branche Lutteur : déplacer les ennemis, tenir une ligne.
[
  {
    // Frappe et projette la cible ; dégâts de collision contre un mur ou une unité.
    "id": "projection", "name": "Projection",
    "weight": "light", "range": 1, "minDamage": 9, "maxDamage": 13, "cooldownMs": 10000,
    "forcedMove": { "type": "push", "distance": 3, "collisionMinDamage": 7, "collisionMaxDamage": 11 }
  },
  {
    // Petit coup au contact qui immobilise la cible (elle peut encore agir sur place).
    "id": "arm-lock", "name": "Clé",
    "weight": "light", "range": 1, "minDamage": 6, "maxDamage": 9, "cooldownMs": 10000,
    "effects": [ { "status": "immobilized", "durationMs": 3000 } ]
  },
  {
    // Variante de la Clé : un simple coup, sauf contre un robot, à qui il arrache des pièces (gros dégâts, étourdi).
    "id": "dismantle", "name": "Démontage",
    "weight": "light", "range": 1, "minDamage": 6, "maxDamage": 9, "cooldownMs": 10000,
    "vsRobots": { "statusDurationPercent": 100, "minDamage": 14, "maxDamage": 18, "effects": [ { "status": "stunned", "durationMs": 2000 } ] }
  },
  {
    // Variante de la Projection : la cible est jetée derrière lui.
    "id": "reversal", "name": "Renversement",
    "weight": "light", "range": 1, "minDamage": 9, "maxDamage": 13, "cooldownMs": 10000,
    "forcedMove": { "type": "throw", "distance": 3, "collisionMinDamage": 7, "collisionMaxDamage": 11 }
  },
  {
    // Attrape un ennemi au contact, frappe avec lui tout ce qui l'entoure (alliés compris, l'ennemi aussi), puis le
    // lance vers la case choisie (règles du Renversement : la distance se compte depuis sa case).
    "id": "spin-throw", "name": "Tourniquet",
    "weight": "heavy", "range": 0, "minDamage": 14, "maxDamage": 18, "cooldownMs": 18000,
    "zone": { "shape": "square", "size": 1, "throughWalls": false },
    "forcedMove": { "type": "spin", "distance": 3, "collisionMinDamage": 7, "collisionMaxDamage": 11 }
  },
  {
    // Lance un allié debout au contact sur une case libre (5 cases au plus) ; l'allié garde sa jauge.
    "id": "catapult", "name": "Catapulte",
    "target": "ally", "weight": "light", "range": 1, "minDamage": 0, "maxDamage": 0, "cooldownMs": 12000,
    "forcedMove": { "type": "place", "distance": 5 }
  },
  {
    // Variante de la Catapulte : moins loin, mais l'allié blesse les ennemis autour de son atterrissage.
    "id": "cannonball", "name": "Boulet",
    "target": "ally", "weight": "light", "range": 1, "minDamage": 0, "maxDamage": 0, "cooldownMs": 12000,
    "forcedMove": { "type": "place", "distance": 3, "impactMinDamage": 10, "impactMaxDamage": 14 }
  }
]
