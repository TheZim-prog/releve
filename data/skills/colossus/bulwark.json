// Colosse, branche Rempart : protéger les alliés.
[
  {
    // Bloque la prochaine attaque contre les alliés dessous ; tombe à la prochaine action du colosse.
    "id": "dome", "name": "Bouclier de zone",
    "weight": "light", "range": 3, "minDamage": 0, "maxDamage": 0, "cooldownMs": 15000,
    "zone": { "shape": "square", "size": 1, "throughWalls": false },
    "createsDome": true
  },
  {
    // Variante du Bouclier de zone : posé sur un seul allié, qu'il suit. Même règle : une attaque bloquée, et il tombe à
    // la prochaine action du colosse.
    "id": "personal-shield", "name": "Bouclier personnel",
    "target": "ally", "weight": "light", "range": 4, "minDamage": 0, "maxDamage": 0, "cooldownMs": 15000,
    "createsDome": true
  },
  {
    // Grand dôme autour de lui : bloque toutes les attaques contre les alliés dessous (pas lui) tant qu'il le tient,
    // 6 s au plus. Immobile, jauge à 0 ; il tombe s'il est étourdi, désarmé, mis à terre ou déplacé de force.
    "id": "fortress", "name": "Forteresse",
    "weight": "heavy", "range": 0, "minDamage": 0, "maxDamage": 0, "cooldownMs": 25000,
    "chargeMs": 6000,
    "zone": { "shape": "square", "size": 2, "throughWalls": false },
    "createsDome": true, "holdsDome": true
  },
  {
    // Il gagne des PV temporaires : la moitié de ses PV actuels. À lancer avant d'encaisser, pas après.
    "id": "steel-skin", "name": "Peau d'acier",
    "target": "self", "weight": "light", "range": 0, "minDamage": 0, "maxDamage": 0, "cooldownMs": 15000,
    "tempHp": { "percentOfCasterHp": 50, "durationMs": 8000 }
  },
  {
    // Variante de la Peau d'acier : les PV temporaires vont à un allié adjacent (toujours la moitié des PV du colosse).
    "id": "aegis", "name": "Égide",
    "target": "ally", "weight": "light", "range": 1, "minDamage": 0, "maxDamage": 0, "cooldownMs": 15000,
    "tempHp": { "percentOfCasterHp": 50, "durationMs": 8000 }
  },
  {
    // Coup au sol : petits dégâts aux ennemis autour de lui, qui doivent le viser à leur prochaine activation
    // (ou s'approcher de lui s'ils ne peuvent pas l'atteindre). Marche sur les boss.
    "id": "provocation", "name": "Provocation",
    "weight": "light", "range": 0, "minDamage": 4, "maxDamage": 6, "cooldownMs": 12000,
    "zone": { "shape": "square", "size": 2, "throughWalls": false, "affects": "enemies" },
    "tauntActions": 1
  },
  {
    // Variante de la Provocation : un seul ennemi, à distance, pour ses deux prochaines activations.
    "id": "challenge", "name": "Défi",
    "weight": "light", "range": 5, "minDamage": 0, "maxDamage": 0, "cooldownMs": 12000,
    "tauntActions": 2
  }
]
