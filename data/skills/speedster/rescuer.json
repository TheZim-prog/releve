    "weight": "heavy", "range": 0, "minDamage": 0, "maxDamage": 0, "cooldownMs": 25000,
    "zone": { "shape": "square", "size": 2, "throughWalls": false, "affects": "allies" },
    "effects": [ { "status": "hasted", "durationMs": 2000 } ]
  },
  {
    // Court jusqu'à un ennemi (4 pas), le frappe et le repousse de deux cases.
    "id": "clearance", "name": "Dégagement",
    "weight": "light", "range": 4, "minDamage": 6, "maxDamage": 9, "cooldownMs": 10000,
